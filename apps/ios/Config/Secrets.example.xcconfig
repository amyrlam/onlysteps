// Copy to Secrets.xcconfig (same folder) and fill in. Secrets.xcconfig is
// gitignored. Any setting from Base.xcconfig can be overridden here.

DEVELOPMENT_TEAM = ABCDE12345

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// No paid Apple Developer account yet? Use your free Apple ID's Personal
// Team id above and uncomment these. The separate bundle id keeps the real
// one free for your paid team later.
// PAID_APPLE_TEAM = NO
// BUNDLE_ID_PREFIX = app.onlysteps.dev

// Local Supabase (`supabase start`) from a device on the same Wi-Fi:
// SUPABASE_URL = http:/$()/192.168.1.20:54321

// Forks: use your own bundle id prefix and web host.
// BUNDLE_ID_PREFIX = com.example.onlysteps
// WEB_HOST = steps.example.com
